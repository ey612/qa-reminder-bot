<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.qa.reminder</string>

    <key>ProgramArguments</key>
    <array>
        <string>/YOUR_PROJECT_PATH/.venv/bin/python</string>   
        <string>/YOUR_PROJECT_PATH/main.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/YOUR_PROJECT_PATH</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>20</integer>
        <key>Minute</key>
        <integer>10</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/YOUR_PROJECT_PATH/reminder.log</string>

    <key>StandardErrorPath</key>
    <string>/YOUR_PROJECT_PATH/reminder-error.log</string>
</dict>
</plist>